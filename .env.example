DATABASE_URL="postgresql://pubtrack:pubtrack@localhost:5432/pubtrack?schema=public"
PORT=3000
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
JWT_ACCESS_EXPIRES_SECONDS=900
JWT_REFRESH_EXPIRES_SECONDS=604800
CORS_ORIGINS="http://localhost:3001,http://localhost:3002"
NODE_ENV=development
REDIS_URL="redis://localhost:6379"
# Single-line JSON from a Firebase service account. Leave unset to keep
# authoritative in-app notifications while disabling FCM delivery.
FIREBASE_SERVICE_ACCOUNT=
