{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "setupFiles": ["<rootDir>/setup-env.ts"],
  "testRegex": ".e2e-spec.ts$",
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1",
    "^@nestjs/bullmq$": "<rootDir>/mocks/nestjs-bullmq.ts",
    "^bullmq$": "<rootDir>/mocks/bullmq.ts"
  },
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  }
}
